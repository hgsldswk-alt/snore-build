{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鼾声记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snore Log"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鼾聲記錄"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来在你睡觉时录下鼾声。录音只保存在这台 iPhone 上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records your snoring while you sleep. Recordings stay on this iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來在你睡覺時錄下鼾聲。錄音只保存在這台 iPhone 上。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于把你选择保存的分享卡写入照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves a share card to Photos when you choose Save image."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用來把你選擇儲存的分享卡加入照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
