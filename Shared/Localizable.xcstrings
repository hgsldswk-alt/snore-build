        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验结束后，整晚录音、梦话分类、趋势、因素对比和小组件需买断。不会自动扣费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the trial, new full-night audio and sleep-talking clips, trends, factor comparisons and widgets require a one-time purchase. No automatic charges."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束後，新錄的整晚音訊與夢話片段、趨勢、因素比較及小工具需買斷。系統不會自動扣款。"
